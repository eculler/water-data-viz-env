#!/bin/bash

set -ex

# -------------------------------------------------------------
# GitHub CLI (gh)
# -------------------------------------------------------------
curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# -------------------------------------------------------------
# Noppe-style: give jovyan full ownership of /opt/conda
# This means:
#   pip install <pkg>        → /opt/conda  (available immediately, no --user)
#   pip install --user <pkg> → ~/.local    (persists on PVC across restarts)
#   conda/mamba install      → /opt/conda  (works without sudo)
# -------------------------------------------------------------
chown -R ${NB_UID}:${NB_GID} /opt/conda

# -------------------------------------------------------------
# Micromamba root prefix → /opt/conda so envs land in the
# standard conda location instead of ~/.local/share/mamba
# -------------------------------------------------------------
export MAMBA_ROOT_PREFIX=/home/jovyan/.local/share/mamba \
    MAMBA_EXE=/usr/local/bin/micromamba

# Initialize micromamba shell hook for bash:
#   - /etc/bash.bashrc  → JupyterLab terminal (interactive non-login)
#   - /etc/profile.d/   → login shells
# Root prefix is ~/.local/share/mamba — lives on the PVC so envs
# persist across pod restarts and are always writable at runtime.
micromamba shell init --shell bash --root-prefix=/home/jovyan/.local/share/mamba && \
    echo 'eval "$(micromamba shell hook --shell bash)"' >> /etc/bash.bashrc && \
    echo 'eval "$(micromamba shell hook --shell bash)"' > /etc/profile.d/micromamba.sh && \
    chmod +x /etc/profile.d/micromamba.sh

# Convenience aliases so muscle memory works regardless of which
# command the user types: deactivate, conda deactivate, micromamba deactivate
cat >> /etc/bash.bashrc << 'BASHRC'

alias conda="micromamba"

# create-env <name> [python=3.x] [pkg1 pkg2 ...]
# Creates the env, registers it as a Jupyter kernel, then activate it.
# Example: create-env myenv python=3.11 numpy pandas
create-env() {
    local env_name="${1:?Usage: create-env <env-name> [python=3.x] [packages...]}"
    shift
    micromamba create -n "${env_name}" -c conda-forge -y ipykernel "$@" && \
    micromamba run -n "${env_name}" python -m ipykernel install \
        --user \
        --name="${env_name}" \
        --display-name="Python (${env_name})" && \
    micromamba activate "${env_name}"
    echo "✅ Env ready. Press F5 then select 'Python (${env_name})' in the notebook."
}
BASHRC

# -------------------------------------------------------------
# Resolve libnss_wrapper.so path at build time
# -------------------------------------------------------------
NSS_WRAPPER_LIB=$(find /usr/lib -name "libnss_wrapper.so" 2>/dev/null | head -1) && \
    echo "NSS_WRAPPER_LIB=${NSS_WRAPPER_LIB}" >> /etc/environment && \
    echo "Found libnss_wrapper at: ${NSS_WRAPPER_LIB}"

# -------------------------------------------------------------
# PATH — three layers so every context gets it
# (terminal, notebook kernel, subprocess, login shell)
# -------------------------------------------------------------
export PATH="/home/jovyan/.local/bin:/opt/conda/bin:${PATH}" \
    PYTHONUSERBASE="/home/jovyan/.local"

echo 'export PATH="/home/jovyan/.local/bin:/opt/conda/bin:$PATH"' >> /etc/bash.bashrc && \
    echo 'export PATH="/home/jovyan/.local/bin:/opt/conda/bin:$PATH"' \
        > /etc/profile.d/user-local-path.sh && \
    chmod +x /etc/profile.d/user-local-path.sh

# Jupyter server config: PATH is set before any kernel starts
# so !cookiecutter, !black, subprocess.run(...) all work in notebooks
mkdir -p /etc/jupyter && \
    cat > /etc/jupyter/jupyter_server_config.py << 'EOF'
import os
os.environ.setdefault(
    "PATH",
    "/home/jovyan/.local/bin:/opt/conda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
)
EOF

# -------------------------------------------------------------
# Git global defaults
# -------------------------------------------------------------
git config --system core.editor "nano" && \
    git config --system init.defaultBranch main

# -------------------------------------------------------------
# Nano — friendlier defaults
# -------------------------------------------------------------
cat > /etc/nanorc << 'EOF'
set softwrap
set mouse
set linenumbers
include "/usr/share/nano/*.nanorc"
EOF

# -------------------------------------------------------------
# GitHub SSH — pre-seed known_hosts so users are never blocked
# Users mount their private key via Kubernetes secret or paste it
# -------------------------------------------------------------
export REPO_URL=https://github.com/DigitalWaters-fi/community.git

mkdir -p /home/jovyan/.ssh && \
    ssh-keyscan github.com >> /home/jovyan/.ssh/known_hosts && \
    chmod 700 /home/jovyan/.ssh && \
    chmod 644 /home/jovyan/.ssh/known_hosts && \
    chown -R ${NB_UID}:${NB_GID} /home/jovyan/.ssh

# -------------------------------------------------------------
# Entrypoint (Noppe-style)
# -------------------------------------------------------------
cat << 'EOF' > /usr/local/bin/nss-entrypoint.sh
#!/bin/bash
set -e

USER_ID=$(id -u)
GROUP_ID=$(id -g)

source /etc/environment 2>/dev/null || true
NSS_LIB="${NSS_WRAPPER_LIB:-$(find /usr/lib -name 'libnss_wrapper.so' 2>/dev/null | head -1)}"

if [ -n "$NSS_LIB" ] && [ -f "$NSS_LIB" ]; then
    export NSS_WRAPPER_PASSWD=/tmp/passwd
    export NSS_WRAPPER_GROUP=/tmp/group
    export LD_PRELOAD="$NSS_LIB"
    echo "jupyter:x:${USER_ID}:${GROUP_ID}:Jupyter User:${HOME}:/bin/bash" > "${NSS_WRAPPER_PASSWD}"
    echo "jupyter:x:${GROUP_ID}:" > "${NSS_WRAPPER_GROUP}"
else
    echo "WARNING: libnss_wrapper.so not found, skipping NSS wrapper setup"
fi

# Fix SSH private key permissions (600 required by SSH)
if [ -d "$HOME/.ssh" ]; then
    for key in "$HOME/.ssh"/*; do
        [ -f "$key" ] || continue
        [[ "$key" == *.pub ]]            && continue
        [[ "$key" == *known_hosts* ]]    && continue
        [[ "$key" == *config* ]]         && continue
        [[ "$key" == *authorized_keys* ]] && continue
        chmod 600 "$key" 2>/dev/null || true
    done
fi

# Clone community repo on first start only
# Set REPO_URL env var to override the default repo
cd "$HOME"
if [ ! -d community/.git ]; then
    if [ -d community ]; then
        echo 'community folder exists but is NOT a git repo — keeping user data unchanged.'
    else
        echo 'Cloning community repo...'
        timeout 30 git clone "${REPO_URL}" community || echo 'Clone failed, continuing anyway...'
    fi
fi

export PATH="$HOME/.local/bin:/opt/conda/bin:${PATH}"
export MAMBA_ROOT_PREFIX="${HOME}/.local/share/mamba"
export MAMBA_EXE=/usr/local/bin/micromamba
eval "$(micromamba shell hook --shell bash)" 2>/dev/null || true

# Resolve CLI tools that live in non-standard locations
CMD_NAME="$1"
if [ -n "$CMD_NAME" ] && ! command -v "$CMD_NAME" &>/dev/null; then
    FOUND=$(find /opt/conda /usr/local/bin -name "$CMD_NAME" -type f 2>/dev/null | head -1)
    if [ -n "$FOUND" ]; then
        echo "Resolved $CMD_NAME -> $FOUND"
        shift
        set -- "$FOUND" "$@"
    else
        echo "WARNING: command '$CMD_NAME' not found anywhere, attempting exec anyway..."
    fi
fi

echo ""
echo "=============================================="
echo "  Welcome to the DIWA Earth Sciences Lab"
echo "=============================================="
echo ""
echo "  Create env, activate & register as kernel:"
echo "    create-env myenv python=3.11 numpy pandas"
echo ""
echo "  Install packages (session):"
echo "    pip install <package>"
echo ""
echo "  Install packages (persists across restarts):"
echo "    pip install --user <package>"
echo ""
echo "  GitHub CLI: gh auth login"
echo "=============================================="
echo ""

exec "$@"
EOF

chmod +x /usr/local/bin/nss-entrypoint.sh

# -------------------------------------------------------------
# OpenShift: group-writable so arbitrary UIDs can write
# -------------------------------------------------------------
# Minimal permission fix — only home dir, not /opt/conda.
# chown /opt/conda was already done above. Calling fix-permissions on
# /opt/conda recursively touches thousands of files and causes Kubernetes
# to take much longer setting volume ownership on pod start (fsGroup chown).
chown -R ${NB_UID}:${NB_GID} /home/jovyan && \
    chmod -R g+rX /home/jovyan
